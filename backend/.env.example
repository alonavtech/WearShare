# ---- Groq (AI clothing descriptions) ----
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Database ----
# Leave empty to use a local SQLite file (wearshare.db) while developing.
# Tiger Data / Tiger Cloud example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# ---- Auth0 ----
# Leave both empty to use DEV LOGIN (send an "X-Dev-User: <username>" header).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ---- App ----
# Random long string used to sign private image URLs. Change it!
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins ("*" allows all, fine for dev)
CORS_ORIGINS=*
APP_TIMEZONE=America/New_York
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
